@startuml
' ============================================================
'  GVRP Engine API - component architecture (Component)
' ============================================================
skinparam componentStyle rectangle
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam ArrowColor #2C3E50
skinparam component {
  BorderColor #34495E
  BackgroundColor #ECF0F1
}
skinparam package {
  BorderColor #7F8C8D
  BackgroundColor #FBFCFC
}

title GVRP Engine API — component architecture (Green VRP, Spring Boot + jsprit + GraphHopper)

actor "Entry API\n(caller)" as Entry
cloud "OSM\nvietnam-251213.osm.pbf" as OSM

package "GVRP_Engine_API (Spring Boot :8081)" {

  package "Controller" {
    [OptimizationController] as CTRL
  }

  package "Job (live state)" {
    [JobRegistry] as JOBREG
    note bottom of JOBREG
      In-memory: iteration, bestCost,
      cancel flag, phase, TTL eviction
    end note
  }

  package "Service - core orchestration" {
    [OptimizationService\n«@Async»] as OPT
    [SolutionMetricsCalculator] as METRIC
    [OptimizationResultExtractor] as EXTRACT
    [GreenVRPCostCalculator] as GREEN
    [ParetoWeightSampler] as PARETO
  }

  package "Clustering (cluster-first)" {
    [KMeansClusterer] as KMEANS
    [ClusterMergeService] as MERGE
    [VehicleClusterAssigner] as VASSIGN
  }

  package "Distance Matrix" {
    [DistanceMatrixService] as DMS
    [MatrixMask] as MASK
    [BlockDiagonalCostMatrix] as BLOCK
    [DenseCostMatrix] as DENSE
    [GraphHopperDistanceProvider] as GHPROV
    [MatrixBasedTransportCosts] as TCOST
  }

  package "Solver (jsprit library)" {
    [VehicleRoutingAlgorithm\n(Ruin & Recreate)] as JSPRIT
    [Constraints:\nNoPrunedEdge / MaxDistance / ClusterRoute] as CONS
  }

  package "Outbox / Callback" {
    [CallbackService] as CB
    [ResultSpool\n(pending/sent/poison)] as SPOOL
    [CallbackRetryScheduler\n«@Scheduled»] as RETRY
  }

  package "Config" {
    [WebConfig\n(RestTemplate, CORS)] as WEBCFG
    [AppConstant] as CONST
  }
}

database "Filesystem\n.data/results/*" as FS
database "GraphHopper\n.cache/routing-graph" as GHCACHE

' ---- Inbound ----
Entry --> CTRL : POST /optimization\n(job_id, orders, vehicles, depots)
CTRL --> OPT : optimizeAsync(request)
CTRL --> JOBREG : progress / cancel
CTRL ..> SPOOL : GET /result, POST /resend

' ---- Orchestration ----
OPT --> JOBREG : register / snapshot / markTerminal
OPT --> KMEANS : (when ≥ 1000 orders)
KMEANS --> MERGE
MERGE --> VASSIGN
VASSIGN --> MASK : clusterAssignment

OPT --> DMS : createDistanceMatrix(coords, mask)
DMS --> MASK : needed(i,j)?
DMS --> BLOCK : sparse layout (with clusters)
DMS --> DENSE : dense layout (Pareto/small)
DMS --> GHPROV : fetch(i,j)
GHPROV --> GHCACHE
GHCACHE ..> OSM : imported once

OPT --> GREEN : buildGreenVehicleType\n(weighted cost+CO2)
OPT --> PARETO : (when Pareto is enabled)
GREEN --> TCOST : cost matrix (physical only)
OPT --> JSPRIT : searchSolutions()
JSPRIT --> CONS : insertion constraint checks
JSPRIT --> JOBREG : IterationListener → snapshot

' ---- Results ----
OPT --> METRIC : compute real metrics
OPT --> EXTRACT : extract routes + unassigned
OPT --> CB : sendCompletionCallback
CB --> SPOOL : store() BEFORE sending
SPOOL --> FS
CB --> Entry : POST /solutions/callbacks/complete
RETRY --> SPOOL : scan pending/
RETRY --> CB : resend (exponential backoff)

@enduml
