' ============================================
' GVRP documentation — shared PlantUML styling
' ============================================
' This file is an !include fragment, not a diagram: it has no @startuml /
' @enduml of its own, so it cannot be rendered on its own and must not be
' counted as a diagram. Include it from a class diagram with
'     !include ../../_shared/puml-styling.puml
' (adjust the relative path for the diagram's folder).

skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam backgroundColor #FFFFFF
skinparam class {
    BackgroundColor<<Entity>> LightYellow
    BackgroundColor<<Service>> LightBlue
    BackgroundColor<<Repository>> LightGreen
    BackgroundColor<<Controller>> LightCoral
    BackgroundColor<<DTO>> Wheat
    BackgroundColor<<Validator>> LightPink
    BackgroundColor<<Mapper>> LightCyan
    BackgroundColor<<Parser>> Lavender
    BackgroundColor<<Engine>> LightGoldenRodYellow
    BorderColor Black
    ArrowColor Black
}

legend right
    |<back:LightYellow>   </back>| Entity Classes |
    |<back:LightBlue>     </back>| Service Classes |
    |<back:LightGreen>    </back>| Repository Interfaces |
    |<back:LightCoral>    </back>| Controller Classes |
    |<back:Wheat>         </back>| DTO Classes |
    |<back:LightPink>     </back>| Validator Classes |
    |<back:LightCyan>     </back>| Mapper Classes |
    |<back:Lavender>      </back>| Parser/Generator |
    |<back:LightGoldenRodYellow></back>| Engine/Calculator |

    **Relationships:**
    ---> uses/depends on
    *--> composition (strong ownership)
    o--> aggregation (weak ownership)
    ..> association
endlegend
