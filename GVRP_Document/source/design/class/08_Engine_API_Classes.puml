title GVRP Engine API - Class Overview (from source code)

' ============================================
' Controller Layer
' ============================================
package "Controller Layer" {
    class OptimizationController <<Controller>> {
        + optimize(request: EngineOptimizationRequest): EngineOptimizationResponse
        + evaluate(request: RouteEvaluateRequest): RouteEvaluateResponse
    }
    class GlobalExceptionHandler <<Controller>> {
        + handleValidationException(): ErrorResponse
        + handleIllegalArgumentException(): ErrorResponse
        + handleGenericException(): ErrorResponse
    }
    class ErrorResponse <<DTO>> {
    }
}

' ============================================
' Orchestration (Optimization flow)
' ============================================
package "Orchestration" {
    class OptimizationService <<Service>> {
        + optimizeAsync(request: EngineOptimizationRequest): CompletableFuture<Void>
        + optimize(request: EngineOptimizationRequest, handle: JobHandle): OptimizationResult
    }
    class RouteEvaluationService <<Service>> {
        + evaluate(request: RouteEvaluateRequest): RouteEvaluateResponse
    }
    class GreenVRPCostCalculator <<Engine>> {
        + buildPhysicalCostMatrix(costs: CostMatrix, locations: List<Location>)
        + buildGreenVehicleType(vehicleType: VehicleType, costWeight: double, co2Weight: double)
        + calculateRouteCO2(distanceKm: double, vehicleType: VehicleType): double
    }
    class SolutionMetricsCalculator <<Engine>> {
        + calculate(solution, context: OptimizationContext, matrix: DistanceTimeMatrix): SolutionMetrics
    }
    class OptimizationResultExtractor <<Engine>> {
        + extractRouteDetails(solution, context: OptimizationContext, matrix: DistanceTimeMatrix)
        + extractUnassignedOrders(solution, context: OptimizationContext)
    }
    class SolutionConverter <<Engine>> {
        + convertToSolutionData(result: OptimizationResult)
    }
    class ParetoWeightSampler <<Engine>> {
        + WeightPoint(label: String, costWeight: double, co2Weight: double)
    }
    class UnassignedOrderDiagnosticService <<Engine>> {
    }
}

' ============================================
' Job & Callback
' ============================================
package "Job & Callback" {
    class JobRegistry <<Service>> {
        + register(jobId: long): JobHandle
    }
    class JobHandle <<Service>> {
        + jobId(): long
        + isCancelRequested(): boolean
        + status(): Status
    }
    enum Status {
        RUNNING
        COMPLETED
        FAILED
        CANCELLED
    }
    enum Phase {
        BUILDING_MATRIX
        SOLVING
    }
    class CallbackService <<Service>> {
        + sendCompletionCallback(jobId: Long, result: OptimizationResult): void
        + sendFailureCallback(jobId: Long, errorMessage: String): void
        + sendCancelledCallback(jobId: Long, reason: String): void
    }
    class ResultSpool <<Service>> {
        + store(jobId: Long, payload: Map): void
        + listPending(): List<Long>
        + markSent(jobId: Long): void
    }
    class CallbackRetryScheduler <<Service>> {
        + resendPending(): void
    }
}

